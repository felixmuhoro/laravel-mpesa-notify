{
    "name": "felixmuhoro/laravel-mpesa-notify",
    "description": "Multi-channel notifications (mail, SMS via Africa's Talking, Slack, database) for M-Pesa payment events.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "mpesa", "notifications", "sms", "africas-talking", "kenya"],
    "authors": [
        {
            "name": "Felix Muhoro",
            "email": "hi@felixmuhoro.dev"
        }
    ],
    "require": {
        "php": "^8.1",
        "felixmuhoro/laravel-mpesa": "^1.2",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "FelixMuhoro\MpesaNotify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FelixMuhoro\MpesaNotify\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FelixMuhoro\MpesaNotify\MpesaNotifyServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
